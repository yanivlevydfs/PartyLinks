ass=\"event-card sv-event-card-designed sv-card-family--mixed sv-card-format--both\" data-sv-source-event-id=\"65156\" data-sv-card-family=\"mixed\" data-sv-card-families-classes=\"salsa,bachata\" data-sv-card-families-socials=\"salsa,bachata\" data-sv-card-families-festivals=\"\" data-sv-card-scope-event-types=\"classes,socials,festivals\" itemscope itemtype=\"https://schema.org/Event\">\n    <a itemprop=\"url\" href=\"https://www.salsavida.com/event/israel/jerusalem/jlmambo-salsa-bachata-in-jerusalem/\">\n                    <span class=\"screen-reader-text\">Salsa + Bachata, Class &amp; Social</span>\n                <div class=\"event-image-wrap\">\n            <img src=\"https://www.salsavida.com/wp-content/uploads/2025/04/salsa-social-icon.jpg\" alt=\"JLMambo Salsa &#038; Bachata in Jerusalem\" class=\"event-image\" loading=\"lazy\" decoding=\"async\" itemprop=\"image\" />            <div class=\"img-label both\" aria-hidden=\"true\">Class &amp; Social</div>            <div class=\"sv-card-family-notch\" aria-hidden=\"true\">Salsa + Bachata</div>        </div>\n        <div class=\"event-list-details\">\n                            <div class=\"event-time\"><span class=\"sv-card-time-value\">8:00 PM - 11:00 PM</span></div>\n            <h3 class=\"event-title\" itemprop=\"name\">JLMambo Salsa &#038; Bachata in Jerusalem</h3>\n                        <div class=\"recurring\"><p><i class=\"calendar-icon\" aria-hidden=\"true\">\r\n            </i><span itemprop=\"location\" itemscope itemtype=\"https://schema.org/Place\">\r\n                <meta itemprop=\"name\" content=\"Jerusalem\">\r\n                                    <meta itemprop=\"address\" content=\"JLMambo Studio David Ayalon Street 1 Jerusalem 9334329 Israel\">\r\n                                Jerusalem            </span></p></div>\r\n                        <div class=\"event-datetime event-detail\"><i class=\"calendar-icon\" aria-hidden=\"true\">\n            </i><div class=\"label-block\">\r\n                                    <time datetime=\"2026-12-09T20:00:00+02:00\" itemprop=\"startDate\">Wednesday, Dec 9, 2026</time>\r\n            </div></div>\n                                      <div itemprop=\"offers\" itemscope itemtype=\"https://schema.org/Offer\">\n                <meta itemprop=\"url\"  content=\"https://www.jlmambo.com/\">\n                                  <meta itemprop=\"price\" content=\"20.00\">\n                  <meta itemprop=\"priceCurrency\" content=\"ILS\">\n                                <meta itemprop=\"availability\" content=\"https://schema.org/InStock\">\n                              </div>\n            <meta itemprop=\"description\" content=\"JLMambo brings vibrant Salsa and Bachata dance classes and social dancing to Jerusalem every Sunday and Wednesday evening, right under Teddy Stadium.\r\nHosted by experienced instructors Noa &amp; Tomer, JLMambo offers a welcoming and inclusive atmosphere where dancers of all levels — from complete beginners to seasoned social dancers — can learn and practice Latin dance in a fun and supportive environment.\r\nEach session kicks off with group classes starting at 19:00, focusing on both Salsa and Bachata fundamentals, followed by a lively social dance party later in the evening where attendees can put their new skills into practice.\r\nNo partner is needed to join — the community spirit and friendly vibe make this a great place to meet new people and groove to Latin rhythms in the heart of Jerusalem.\r\nWhether you’re just starting out or looking to sharpen your dance skills, JLMambo provides an energetic weekly hub for salsa and bachata lovers from around the city and beyond.\">\r\n            <meta itemprop=\"eventAttendanceMode\" content=\"https://schema.org/OfflineEventAttendanceMode\">\r\n            <meta itemprop=\"eventStatus\"         content=\"https://schema.org/EventScheduled\">\r\n                                        <div itemprop=\"organizer\" itemscope itemtype=\"https://schema.org/Organization\">\r\n                    <meta itemprop=\"name\" content=\"JLMambo Studio\">\r\n                    <meta itemprop=\"url\" content=\"https://www.jlmambo.com/\">                </div>\r\n                                        <div itemprop=\"performer\" itemscope itemtype=\"https://schema.org/PerformingGroup\">\r\n                    <meta itemprop=\"name\" content=\"JLMambo Studio\">\r\n                </div>\r\n                    </div>\r\n    </a>\r\n    <meta itemprop=\"endDate\" content=\"2026-12-09T23:00:00+02:00\"></article>",
