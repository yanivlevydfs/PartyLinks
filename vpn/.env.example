# Parameters of the vpn service (Railway service "vpn"; locally: copy to .env, which git ignores).
# Values for CyberGhost: "Configure routers or other devices", OpenVPN, Israel, Premium Servers.

# Server and protocol
VPN_REMOTE=87-1-il.cg-dialup.net
VPN_PORT=443
VPN_PROTO=udp
VPN_CIPHERS=AES-256-GCM:AES-128-GCM:AES-256-CBC
VPN_AUTH=SHA256

# Credentials (secret): the username and password from that CyberGhost page
VPN_USERNAME=
VPN_PASSWORD=

# Certificates and key (secret): base64 of ca.crt, client.crt, client.key from the downloaded zip
#   base64 -w0 ca.crt
VPN_CA_B64=
VPN_CERT_B64=
VPN_KEY_B64=

# Proxy the web service connects to: http://vpn.railway.internal:8888
VPN_PROXY_PORT=8888
# Who may use the proxy (space-separated networks): Railway's private network, IPv6 fd12::/16 and IPv4 10.x
VPN_ALLOW=fd00::/8 10.0.0.0/8 127.0.0.1 ::1
# The tunnel MTU inside tunproxy: Railway's railnet0 is 1316, minus ~52 bytes of OpenVPN UDP overhead
VPN_MTU=1200
