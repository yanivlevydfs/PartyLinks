PYTHONPATH=src
# Admin console (/admin) and the mutating API routes. Unset = localhost only.
PARTYLINKS_ADMIN__TOKEN=change-me-to-a-long-random-string
# Outgoing proxy for scraping / image downloads (optional), e.g. http://user:pass@host:port
# PARTYLINKS_HTTP__PROXY=
# Logs: text (default) or json; a rotating file under data/logs/ unless set empty.
# PARTYLINKS_LOGGING__FORMAT=json
# PARTYLINKS_LOGGING__FILE=
# Optional Google accounts (docs/accounts.md). Without all of the first three, sign-in is off.
# OAuth client "SPOTX web"; its redirect URIs include http://localhost:8000/auth/google/callback.
# PARTYLINKS_ACCOUNTS__GOOGLE_CLIENT_ID=
# PARTYLINKS_ACCOUNTS__GOOGLE_CLIENT_SECRET=
# PARTYLINKS_ACCOUNTS__SESSION_SECRET=   # python -c "import secrets;print(secrets.token_urlsafe(48))"
# PARTYLINKS_ACCOUNTS__ADMIN_EMAILS=["you@example.com"]
# Email through Resend (a send-only key is enough). Unset = no email at all.
# PARTYLINKS_MAIL__RESEND_API_KEY=
